# ---------- Hedera testnet (JSON-RPC relay) ----------
HEDERA_TESTNET_RPC=https://testnet.hashio.io/api
HEDERA_CHAIN_ID=296
# EVM ECDSA private key of the deployer (hex, no 0x is also accepted by hardhat >= 2.22)
DEPLOYER_PRIVATE_KEY=

# ---------- Hedera native (ATS SDK needs account id + DER key) ----------
HEDERA_OPERATOR_ID=0.0.xxxxxx
HEDERA_OPERATOR_KEY=302e0201...
HEDERA_NETWORK=testnet
ATS_FACTORY_ADDRESS=
ATS_RESOLVER_ADDRESS=

# ---------- World ID / Selfie Check ----------
NEXT_PUBLIC_WORLD_APP_ID=app_staging_xxxxxxxxxxxxxxxx
NEXT_PUBLIC_WORLD_ACTION=godaam-farmer-verify
# World's unified verification host. /api/v2/verify is retired and returns a
# misleading "Action not found" for actions that exist; /api/v4/verify serves both
# 4.0 and legacy 3.0 proofs. A stale developer.worldcoin.org value here fails in a
# way that looks like a bad action id.
WORLD_API_BASE=https://developer.world.org
# Server-side signer that attests verified World ID proofs to WorldIdRegistry
WORLD_ATTESTOR_PRIVATE_KEY=

# ---------- Chainlink CRE ----------
CRE_WORKFLOW_OWNER=
CRE_FORWARDER_ADDRESS=
CRE_WORKFLOW_NAME=godaam-risk-scoring

# ---------- Deployed contract addresses (filled by scripts/deploy.ts) ----------
NEXT_PUBLIC_WORLD_ID_REGISTRY=
NEXT_PUBLIC_WAREHOUSE_RECEIPT=
NEXT_PUBLIC_MOCK_USDC=
NEXT_PUBLIC_GODAAM_VAULT=

# ---------- Chainlink CRE: workflow trigger (app -> TEE) ----------
# Without CRE_TRIGGER_URL, POST /api/cre/assess returns 503 and the underwriting
# path in the UI is inactive. That is the CURRENT, DELIBERATE state.
#
# Do NOT point this at `cre workflow simulate --listen`. That server accepts the
# trigger and executes the workflow correctly, but answers the HTTP request with
# Content-Length: 0 - the result goes to the simulator's stdout, not the response.
# Parsed as JSON that is {}, which would surface as riskScore 0 / approved false:
# a decline indistinguishable from a real one. /api/cre/assess now refuses an empty
# or incomplete body rather than reporting it as a decision.
#
# A working value needs a DEPLOYED workflow's trigger URL. Deploy access is
# requested and pending (`cre account access`). Until then, leave this blank.
CRE_TRIGGER_URL=
# Optional bearer token for the trigger endpoint. Omit for a local simulator.
CRE_TRIGGER_API_KEY=
# "true" once the workflow is deployed and reports come from a real DON. Controls the
# `mode` field returned by /api/cre/assess and whether demo-lifecycle.ts calls the
# workflow or falls back to its hand-encoded report.
CRE_LIVE=false
# Personal API key for the `cre` CLI, from https://app.chain.link (Account Settings).
# `cre workflow simulate` and `cre workflow deploy` both refuse to run without either
# this or an interactive `cre login`.
CRE_API_KEY=

# ---------- Attestor address ----------
# Public address matching WORLD_ATTESTOR_PRIVATE_KEY. scripts/deploy.ts registers it as
# the WorldIdRegistry attestor AND grants it ISSUER_ROLE on WarehouseReceipt. Leave blank
# to use the deployer for both. If this is set but the grant is skipped, /api/worldid/verify
# writes the nullifier and then reverts on grantKyc, leaving a farmer who looks verified
# but can never hold collateral.
WORLD_ATTESTOR_ADDRESS=

# ---------- Frontend RPC / wallet ----------
# Browser-side RPC for Hedera testnet reads. Defaults to Hashio, which rate-limits hard
# during a live demo - prefer an Arkhia or Validation Cloud key.
NEXT_PUBLIC_HEDERA_RPC=
# WalletConnect project id. Without it only the injected (MetaMask) connector is offered.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---------- ATS token linkage (output of `npm run ats:issue`) ----------
# Written into WarehouseReceipt.ReceiptData so the EVM collateral record points at the real
# Hedera asset. demo-lifecycle.ts falls back to 0.0.0 / the zero address when unset.
ATS_TOKEN_ID=
ATS_TOKEN_EVM_ADDRESS=

# ---------- World ID 4.0 (Relying Party) ----------
# Public RP identifier from the Developer Portal, shown after clicking
# "Enable World ID 4.0" on the app. Safe on the client.
# Without it: /api/rp-signature returns 503 and no proof can be requested at all,
# because every IDKit preset requires a signed rp_context. It is also the path
# segment for /api/v4/verify/{rp_id} - an app_id there will not work for a 4.0 proof.
NEXT_PUBLIC_WORLD_RP_ID=
# SECRET. The RP signing key, downloaded from the Developer Portal alongside the
# rp_id. Signs each proof request server-side.
# NEVER give this a NEXT_PUBLIC_ prefix - that compiles it into the browser bundle
# and ships it to every visitor. `npm run check:worldid` asserts it has not happened.
# Without it: /api/rp-signature returns 503 naming this variable.
WORLD_SIGNING_KEY=

# ---------- Optional test / demo overrides ----------
# All three have working defaults; listed so an absent variable is never mistaken
# for a missing one.
# demo-lifecycle.ts land record, defaults to "MH-PUN-0421/2A".
DEMO_LAND_RECORD_REF=
# Pins the address used by `npm run check:gate`; defaults to a fresh random one.
GATE_TEST_ADDRESS=
# Where `npm run check:worldid -- --live` looks for the app. Defaults to
# http://localhost:3000. Set this to a LAN IP or tunnel URL when testing from a phone.
PREFLIGHT_APP_URL=
