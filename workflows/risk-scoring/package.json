{
  "name": "godaam-risk-scoring",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cre-compile main.ts dist/workflow.wasm",
    "verify": "bun run verify-fixtures.ts",
    "simulate": "cre workflow simulate . --http-payload fixtures/good-farmer.json --config config.json",
    "simulate:risky": "cre workflow simulate . --http-payload fixtures/risky-farmer.json --config config.json",
    "deploy": "cre workflow deploy . --config config.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chainlink/cre-sdk": "1.20.1",
    "viem": "^2.56.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
