{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "target": "es2020",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // `next build` typechecks everything in `include`, so the Hardhat scripts and tests
  // were being compiled by the Next build. They depend on `typechain-types/`, which is
  // generated by `hardhat compile` and gitignored - so they typecheck locally, where it
  // exists, and fail on a clean CI checkout, where it does not. That is how
  // scripts/demo-lifecycle.ts broke a Vercel build with an implicit-any it never showed
  // here. They are typechecked by Hardhat instead, via tsconfig.hardhat.json.
  //
  // Note this does not un-typecheck scripts the app actually imports: TypeScript still
  // follows imports out of included files, so app/api/receipts/issue/route.ts pulling in
  // scripts/ats-issue-receipt.ts keeps that file covered.
  "exclude": ["node_modules", "contracts", "workflows", ".hardhat", "scripts", "test"]
}
